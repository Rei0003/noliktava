<%- include('partials/top', { title: 'Preces' }) %>
<% const canEdit = user.role === 'admin' || user.role === 'darbinieks'; %>

<% if (canEdit) { %>
  <form method="post" action="/products<%= form.id ? '/' + form.id : '' %>" class="card mb-6">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2 class="mb-4 text-xl font-semibold"><%= form.id ? 'Rediģēt preci' : 'Pievienot preci' %></h2>
    <%- include('partials/errors') %>

    <div class="grid gap-4 md:grid-cols-5">
      <label><span class="label">Artikuls</span>
        <input class="input" name="sku" value="<%= form.sku %>" required minlength="2" maxlength="30" pattern="[A-Za-z0-9\-]+" title="Latīņu burti, cipari un -"></label>
      <label class="md:col-span-2"><span class="label">Nosaukums</span>
        <input class="input" name="name" value="<%= form.name %>" required minlength="2" maxlength="100"></label>
      <label><span class="label">Daudzums</span>
        <input class="input" type="number" name="quantity" value="<%= form.quantity %>" required min="0" step="1"></label>
      <label><span class="label">Min. atlikums</span>
        <input class="input" type="number" name="min_quantity" value="<%= form.min_quantity %>" required min="0" step="1"></label>
      <label><span class="label">Cena, EUR</span>
        <input class="input" type="number" name="price" value="<%= form.price %>" required min="0" step="0.01"></label>
    </div>

    <div class="mt-4 flex gap-2">
      <button class="btn"><%= form.id ? 'Saglabāt' : 'Pievienot' %></button>
      <% if (form.id) { %><a href="/products" class="btn-small self-center">Atcelt</a><% } %>
    </div>
  </form>
<% } %>

<div class="card overflow-x-auto">
  <h2 class="mb-4 text-xl font-semibold">Preces noliktavā</h2>
  <table class="table">
    <tr><th>Artikuls</th><th>Nosaukums</th><th>Atlikums</th><th>Izvietots</th><th>Cena</th><% if (canEdit) { %><th></th><% } %></tr>
    <% for (const p of products) { %>
      <tr>
        <td class="font-medium"><%= p.sku %></td>
        <td><%= p.name %></td>
        <td class="<%= p.quantity <= p.min_quantity ? 'font-semibold text-red-700' : '' %>">
          <%= p.quantity %><%= p.quantity <= p.min_quantity ? ' (zems)' : '' %></td>
        <td><%= p.placed %></td>
        <td><%= p.price.toFixed(2) %> €</td>
        <% if (canEdit) { %>
          <td class="whitespace-nowrap text-right">
            <a href="/products?edit=<%= p.id %>" class="btn-small">Rediģēt</a>
            <% if (user.role === 'admin') { %>
              <form method="post" action="/products/<%= p.id %>/delete" class="inline" data-confirm="Dzēst preci <%= p.name %>?">
                <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn-delete">Dzēst</button>
              </form>
            <% } %>
          </td>
        <% } %>
      </tr>
    <% } %>
  </table>
</div>
<%- include('partials/bottom') %>
